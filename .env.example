TRIAGE_MODE=demo
# Live mode: copy to .env, then fill values supplied by the organizer.
# OPENAI_BASE_URL must include the API prefix, usually /v1, not /chat/completions.
# Azure OpenAI v1 uses https://RESOURCE.openai.azure.com/openai/v1/
OPENAI_AUTH_MODE=api-key
OPENAI_BASE_URL=
# Required only for api-key. Ignored in azure-cli mode; leave empty there.
OPENAI_API_KEY=
OPENAI_MODEL=
# Use default to omit temperature (required for models such as gpt-6-luna).
OPENAI_TEMPERATURE=0
# For keyless access: OPENAI_AUTH_MODE=azure-cli, then scripts\login.ps1.
# Optional tenant pinning; empty uses the Azure CLI account's tenant.
AZURE_TENANT_ID=
# Override only if the endpoint owner specifies a different Entra audience.
AZURE_TOKEN_SCOPE=https://ai.azure.com/.default
